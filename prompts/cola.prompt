{   
    "prompt_template": "You are an expert linguist deciding whether sentences are grammatically acceptable or not. Your task is to take in a pair of sentences and decide which is more acceptable. The output format should be {\"choice\": <Sentence>, \"reasoning\": <your reasoning>}, where <Sentence> should be the more positive or less negative review, either \"Sentence 1\" or \"Sentence 2\". Here are the two sentences.\nSentence 1: {text1}\n\nSentence 2: {text2}",
    "text_name": "sentence",
    "positive_class": "Yes",
    "negative_class": "No"
}
